# ── Hermes bridge configuration ─────────────────────────────────────────────
# Copy this file to  .env  and fill in your keys. NEVER commit the real .env.
# Every value is validated at startup; a typo stops the bridge with a clear message.

# ── Providers ───────────────────────────────────────────────────────────────
# Pick the first choice for each stage. Anything without a key is skipped and the
# next provider in the chain is used, so a missing/expired key never kills a reply.
#   STT:  gnani (Prisma)  | groq (Whisper)                -> falls back to the other
#   LLM:  groq | nvidia | evon (Gnani Evon, self-hosted)  -> falls back groq -> nvidia -> evon
#   TTS:  gnani (Timbre, beta) | edge | sapi              -> falls back edge -> gTTS -> Windows voice
STT_PROVIDER=groq
LLM_PROVIDER=groq
TTS_PROVIDER=edge

# ── Gnani (Prisma STT + Timbre TTS) ─────────────────────────────────────────
# Key from the Gnani dashboard (app.gnani.ai). Sent as the X-API-Key-ID header.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
# Prisma needs the language up front: en-IN, hi-IN, ta-IN, te-IN, kn-IN, ml-IN, mr-IN,
# bn-IN, gu-IN, pa-IN, or the pair en-IN,hi-IN for English/Hindi auto-detect.
GNANI_STT_LANGUAGE=en-IN
# verbatim, or transcribe (numbers/dates normalised)
GNANI_STT_FORMAT=verbatim
# timbre-v2.0 voices: Pranav, Kaveri, Shubhra, Deepak. timbre-v2.5 also takes a language.
GNANI_TTS_MODEL=timbre-v2.0
GNANI_TTS_VOICE=Pranav
GNANI_TTS_LANGUAGE=auto
GNANI_TTS_SAMPLE_RATE=22050

# ── Gnani Evon (LLM) ────────────────────────────────────────────────────────
# Any OpenAI-compatible /v1 endpoint serving gnani/gnani-evon-v3.3-30B-A3B,
# e.g. your own vLLM box: http://192.168.1.50:8000/v1  (see README "Gnani demo").
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B

# ── Groq (Whisper STT + chat) — free key: https://console.groq.com/keys ─────
GROQ_API_KEY=
# Groq's daily token limit is PER-MODEL, so if one caps, switch models.
#   Good chat/tool models: openai/gpt-oss-20b, openai/gpt-oss-120b, llama-3.3-70b-versatile
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-20b
# Cap tokens per reply. gpt-oss counts its hidden reasoning here too, so keep this
# roomy (too low = empty replies). REASONING_EFFORT low/medium/high (gpt-oss only).
LLM_MAX_TOKENS=1024
REASONING_EFFORT=low

# ── NVIDIA NIM fallback — free key: https://build.nvidia.com ────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8787
ASSISTANT_NAME=Hermes

# Access token — REQUIRED once you expose the brain beyond your LAN.
# The phone app and the ESP32 must send this. Keep it secret; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
HERMES_TOKEN=

# Requests per minute per client on /voice /chat /talk (0 = off). Also throttles token guessing.
RATE_LIMIT_PER_MIN=30
# Only set to 1 behind a reverse proxy you control (uses X-Forwarded-For for the client IP).
TRUST_PROXY_HEADERS=0
# Timeouts/retries for every outbound provider call.
HTTP_TIMEOUT_S=20
HTTP_RETRIES=2

# text (readable console) or json (one JSON object per line, for Docker / log shipping)
LOG_FORMAT=text
LOG_LEVEL=INFO

# ── Voice output ────────────────────────────────────────────────────────────
# Speak replies through the PC speakers (1 = on, Windows only). Handy if the ESP has no speaker.
PLAY_ON_PC=1
# Free Microsoft neural voices (needs internet). List them:  .venv\Scripts\edge-tts --list-voices
TTS_VOICE=en-US-AvaMultilingualNeural
TTS_VOICE_TA=ta-IN-PallaviNeural
TTS_RATE=+0%

# ── Optional: Spotify playback (needs Premium) ──────────────────────────────
# Create an app at https://developer.spotify.com/dashboard with Redirect URI
# http://127.0.0.1:8787/spotify/callback, paste its Client ID here, restart, then
# open http://127.0.0.1:8787/spotify/login on this PC. No client secret needed.
SPOTIFY_CLIENT_ID=
