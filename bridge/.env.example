# ── Hermes bridge configuration ─────────────────────────────────────────────
# Copy this file to  .env  and fill in your keys. NEVER commit the real .env.

# REQUIRED: your FREE Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Models. Groq's daily token limit is PER-MODEL, so if one caps, switch models.
#   Good chat/tool models: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-20b

PORT=8787
ASSISTANT_NAME=Hermes

# Access token — REQUIRED once you expose the brain beyond your LAN.
# The phone app and the ESP32 must send this. Keep it secret; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
HERMES_TOKEN=

# Optional: speak replies through the PC speakers (1 = on). Handy if the ESP
# has no speaker. English uses the offline Windows voice; Tamil uses gTTS.
PLAY_ON_PC=1

# Optional: cap tokens per reply. gpt-oss counts its hidden reasoning here too, so
# keep this roomy (too low = empty replies). REASONING_EFFORT low/medium/high (gpt-oss only).
LLM_MAX_TOKENS=1024
REASONING_EFFORT=low

# Optional automatic fallback provider (used when Groq is rate-limited).
# Get a free NVIDIA NIM key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: Spotify playback (needs Premium). Create an app at
# https://developer.spotify.com/dashboard with Redirect URI
# http://127.0.0.1:8787/spotify/callback, paste its Client ID here, restart, then
# open http://127.0.0.1:8787/spotify/login on this PC. No client secret needed.
SPOTIFY_CLIENT_ID=
